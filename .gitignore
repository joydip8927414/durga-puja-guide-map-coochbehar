# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (strictly ignore real secrets, allow template)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# vercel
.vercel

# typescript build cache
*.tsbuildinfo
next-env.d.ts

# IDE and tool configs
.idea/
.vscode/
*.swp
*.swo
.qodo/
