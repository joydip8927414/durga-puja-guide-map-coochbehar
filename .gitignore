# ==============================================================================
# Security & Secret Exclusions
# ==============================================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa*
id_ed25519
id_ed25519*

# Database dumps, backups, and local SQLite databases
# (Note: Whitelist supabase/ directory migrations, seed, and tests below)
*.dump
*.bak
*.backup
*.sqlite
*.sqlite3
*.db

# Prevent arbitrary root or temp SQL dumps while allowing version-controlled migrations
*.sql
!supabase/migrations/*.sql
!supabase/seed.sql
!supabase/tests/*.sql

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ==============================================================================
# Build Output & Dependencies
# ==============================================================================

node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & bundler output
/.next/
out/
/build
dist/

# Testing
coverage/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# OS, Tooling & IDE Configurations
# ==============================================================================

.vercel/
.DS_Store
Thumbs.db
ehthumbs.db

.idea/
.vscode/
*.swp
*.swo
.qodo/
