# ==============================================================================
# Cooch Behar Durga Puja Interactive Guide & Navigation App
# Environment Variable Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTES:
# 1. DO NOT commit actual secrets, keys, or database credentials to Git.
# 2. Only variables prefixed with NEXT_PUBLIC_ are exposed to browser bundles.
# 3. Privileged keys (e.g. SUPABASE_SERVICE_ROLE_KEY) MUST NEVER have the
#    NEXT_PUBLIC_ prefix and must only be accessed within server contexts.
# 4. Copy this file to .env.local for local development with your actual test keys.
# ==============================================================================

# Supabase Client Configuration (Public / Safe for browser consumption)
# Used by client-side components to fetch public pandal listings and submit authenticated user requests
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Server-Only Privileged Access (STRICTLY CONFIDENTIAL)
# NEVER prefix with NEXT_PUBLIC_. Only for background workers, migrations, or privileged server actions.
# Requires strict server-side authorization checks and RLS bypass protections.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
